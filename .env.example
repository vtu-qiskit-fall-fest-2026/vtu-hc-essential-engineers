# Copy to .env and fill in. .env is gitignored; never commit a real key.
# Key: https://quantum.cloud.ibm.com (API key panel on the dashboard)
IBM_QUANTUM_TOKEN=
# Optional: instance CRN; leave blank to let the service pick an available instance.
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_CHANNEL=ibm_quantum_platform
IBM_BACKEND=ibm_kingston
